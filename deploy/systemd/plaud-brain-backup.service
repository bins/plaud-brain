[Unit]
Description=Back up PLAUD Brain PostgreSQL
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/bins/plaud-brain
Environment=PATH=/home/bins/.local/bin:/home/bins/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=BACKUP_DIR=/home/bins/plaud-brain/data/backups
Environment=BACKUP_RETENTION_DAYS=30
ExecStart=/home/bins/plaud-brain/scripts/backup_postgres.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/bins/plaud-brain/data
