POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://plaud:change-me@127.0.0.1:5433/plaud_brain
DATA_DIR=./data
PLAUD_BIN=plaud
PLAUD_LOOKBACK_DAYS=3
PLAUD_PAGE_SIZE=100
WHISPER_BIN=./vendor/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=./models/ggml-large-v3-turbo.bin
WHISPER_LANGUAGE=auto
WHISPER_THREADS=8
WHISPER_NO_GPU=true
WHISPER_FLASH_ATTN=false
STT_PROVIDER=local
STT_BASE_URL=https://openrouter.ai/api/v1
STT_MODEL=openai/whisper-large-v3-turbo
STT_API_KEY_ENV=OPENROUTER_API_KEY
STT_CHUNK_SECONDS=480
STT_TIMEOUT_SECONDS=75
STT_FALLBACK_PROVIDER=local
# OPENROUTER_API_KEY=store-this-only-in-your-untracked-.env-file
SUMMARY_PROVIDER=deepseek
SUMMARY_BASE_URL=https://api.deepseek.com
SUMMARY_MODEL=deepseek-flash
SUMMARY_API_KEY_ENV=DEEPSEEK_API_KEY
SUMMARY_TIMEOUT_SECONDS=300
SUMMARY_AUTO=false
# DEEPSEEK_API_KEY=store-this-only-in-your-untracked-.env-file
EMBEDDING_PROVIDER=openrouter
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_API_KEY_ENV=OPENROUTER_API_KEY
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_DOCUMENT_INPUT_TYPE=
EMBEDDING_QUERY_INPUT_TYPE=
EMBEDDING_AUTO=true
QA_PROVIDER=deepseek
QA_BASE_URL=https://api.deepseek.com
QA_MODEL=deepseek-flash
QA_API_KEY_ENV=DEEPSEEK_API_KEY
QA_TIMEOUT_SECONDS=300
QA_TOP_K=8
QA_MIN_SCORE=0.45
WEB_HOST=127.0.0.1
WEB_PORT=8787
WEB_API_TOKEN_ENV=PLAUD_BRAIN_WEB_TOKEN
# PLAUD_BRAIN_WEB_TOKEN=required-if-WEB_HOST-is-not-loopback
DIARIZATION_PROVIDER=disabled
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_TOKEN_ENV=HF_TOKEN
DIARIZATION_MIN_SPEAKERS=
DIARIZATION_MAX_SPEAKERS=
# HF_TOKEN=store-this-only-in-your-untracked-.env-file
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
